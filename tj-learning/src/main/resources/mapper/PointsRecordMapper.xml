<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tianji.learning.mapper.PointsRecordMapper">

    <update id="createPointsRecordTable">
        CREATE TABLE IF NOT EXISTS `${tableName}` LIKE `points_record`
    </update>

    <insert id="migratePointsRecord">
        INSERT INTO `${tableName}`
        SELECT *
        FROM `points_record`
        WHERE `create_time` &gt;= #{begin}
          AND `create_time` &lt; #{end}
    </insert>

    <delete id="deletePointsRecord">
        DELETE
        FROM `points_record`
        WHERE `create_time` &gt;= #{begin}
          AND `create_time` &lt; #{end}
    </delete>
</mapper>